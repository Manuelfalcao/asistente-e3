{
  "name": "asistente-e3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:archivo": "vite build --mode archivo && node scripts/copiar-archivo.mjs",
    "build:muestra": "vite build --mode muestra",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "informe": "node scripts/informe.mjs",
    "format": "prettier --write .",
    "iconos": "node scripts/iconos.mjs",
    "fuente": "python scripts/recortar-fuente.py"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "preact": "^11.0.2",
    "temml": "0.14.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
